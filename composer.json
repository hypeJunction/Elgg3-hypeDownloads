{
    "name": "hypejunction/hypedownloads",
    "type": "elgg-plugin",
    "description": "Digital product shop",
    "homepage": "https://github.com/hypeJunction/hypedownloads",
    "keywords": [
        "elgg",
        "plugin"
    ],
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Ismayil Khayredinov",
            "email": "ismayil.khayredinov@gmail.com"
        }
    ],
    "extra": {
        "installer-name": "hypeDownloads",
        "elgg-plugin": {
            "id": "hypedownloads"
        }
    },
    "require": {
        "php": ">=8.2",
        "composer/installers": "^2.0",
        "elgg/elgg": "~6.1.0"
    },
    "autoload": {
        "psr-0": {
            "": "classes/"
        }
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true
        }
    }
}
